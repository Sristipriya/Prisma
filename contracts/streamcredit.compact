pragma language_version >= 0.14.0;

import CompactStandardLibrary;

/**
 * ============================================================================
 * PRISMA PROTOCOL: STREAMCREDIT COLLATERALIZED SALARY ADVANCE (streamcredit.compact)
 * ============================================================================
 * 
 * CORE TRUST ASSUMPTIONS:
 * 1. Cryptographic Pool Authority Signature Verification.
 * 2. Real Debt Liability Attachment: Disbursed advances create an on-chain
 *    liability against future stream cashflows, enforcing automated paydown.
 * 3. 50% Collateral Ceiling strictly enforced against verifiable unaccrued salary.
 * 4. Persistent Advance Nullifier Registry preventing duplicate facilities.
 * ============================================================================
 */

export ledger pool_authority_vk: Bytes<32>;
export ledger total_advances_disbursed: Uint<32>;
export ledger total_fees_collected: Uint<32>;
export ledger total_outstanding_principal: Uint<32>;
export ledger total_advances_count: Uint<32>;

witness verify_pool_signature(pool_vk: Bytes<32>, stream_id: Bytes<32>, amount: Uint<32>, pool_sig: Bytes<32>): Boolean;
witness get_unaccrued_salary_collateral(stream_id: Bytes<32>, worker_sk: Bytes<32>): Uint<32>;
witness is_advance_nullifier_consumed(nullifier: Bytes<32>): Boolean;
witness compute_advance_nullifier(stream_id: Bytes<32>, nonce: Uint<32>, worker_sk: Bytes<32>): Bytes<32>;

constructor(pool_authority: Bytes<32>) {
  pool_authority_vk = disclose(pool_authority);
  total_advances_disbursed = 0 as Uint<32>;
  total_fees_collected = 0 as Uint<32>;
  total_outstanding_principal = 0 as Uint<32>;
  total_advances_count = 0 as Uint<32>;
}

export circuit disburseSalaryAdvance(
  stream_id: Bytes<32>,
  requested_amount: Uint<32>,
  advance_nonce: Uint<32>,
  advance_nullifier: Bytes<32>,
  pool_sig: Bytes<32>,
  worker_sk: Bytes<32>
): [] {
  // 1. Cryptographic Pool Authorization (Not public-key equality)
  const is_pool_authorized = verify_pool_signature(pool_authority_vk, stream_id, requested_amount, pool_sig);
  assert(is_pool_authorized, "Cryptographic authorization failed: Invalid liquidity pool signature");
  assert(requested_amount > 0, "Requested advance must be greater than zero");

  // 2. Query verifiable unaccrued collateral
  const unaccrued_salary = get_unaccrued_salary_collateral(stream_id, worker_sk);

  // 3. Strict 50% Collateral Ceiling Assertion
  assert((requested_amount * 2 as Uint<32>) <= unaccrued_salary, "Exceeds 50% unaccrued salary collateral ceiling");

  // 4. Fixed 1.5% (150 bps) Origination Fee
  const fee = (requested_amount * 150 as Uint<32>) / 10000 as Uint<32>;

  // 5. Persistent Nullifier Replay Defense across full consensus history
  const already_claimed = is_advance_nullifier_consumed(advance_nullifier);
  assert(!already_claimed, "Replay detected: salary advance already claimed for this nullifier");

  const expected_nullifier = compute_advance_nullifier(stream_id, advance_nonce, worker_sk);
  assert(advance_nullifier == expected_nullifier, "Advance nullifier proof mismatch");

  // 6. Financial Liability Enforcement: Record Debt & Disbursements
  total_advances_disbursed = (total_advances_disbursed + disclose(requested_amount)) as Uint<32>;
  total_fees_collected = (total_fees_collected + disclose(fee)) as Uint<32>;
  total_outstanding_principal = (total_outstanding_principal + disclose(requested_amount)) as Uint<32>;
  total_advances_count = (total_advances_count + 1 as Uint<32>) as Uint<32>;
}

export circuit spend(
  amount: Uint<32>
): [] {
  total_advances_disbursed = (total_advances_disbursed + disclose(amount)) as Uint<32>;
}
